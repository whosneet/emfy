<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Emfy</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- AI providers (A2a): remote providers are reached over HTTPS only; this
	     allows plain-http to a LOCAL network endpoint (Ollama / LM Studio on
	     localhost). NSAllowsArbitraryLoads stays off — no cleartext to the
	     internet; the transport layer additionally rejects http to any
	     non-loopback host. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.graphics-design</string>
	<!-- "Open in New Window" (UIWindowScene.ActivationAction) carries the chosen
	     entry into the new window via this user activity. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.avneetsingh.emfy.openInNewWindow</string>
	</array>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Emfy saves pictures you export to your photo library.</string>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Expose the app's Documents folder in the Files app under "Emfy" (ST2), so the
	     owned drawings Emfy holds the only copy of — received, New and AI-generated —
	     are visible, openable and backed up, rather than hidden in a container. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Multiple windows (v3-plan §9.1): iPad (and the iPhone Duo inner display in a
	     Split View half) can open more than one library window via "Open in New
	     Window", each owning its selection. `openWindow(id:value:)` needs this key;
	     the system's ActivationAction shows the "Open" alternate (opening in the
	     current window) where a second window can't be created — the iPhone and the
	     iPhone Duo OUTER display. An incoming file still lands in the active scene via
	     onOpenURL. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Enhanced Metafile image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<!-- .emf has no system UTI; Emfy's imported declaration resolves it,
			     and the known contenders (Microsoft's, LibreOffice's) are also
			     accepted. -->
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.emf</string>
				<string>org.libreoffice.emf-document</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Windows Metafile image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.wmf</string>
				<string>org.libreoffice.wmf-document</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Compressed Enhanced Metafile image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.emz</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Compressed Windows Metafile image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.wmz</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.emf</string>
			<key>UTTypeDescription</key>
			<string>Enhanced Metafile image</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.image</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>emf</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.wmf</string>
			<key>UTTypeDescription</key>
			<string>Windows Metafile image</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.image</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>wmf</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.emz</string>
			<key>UTTypeDescription</key>
			<string>Compressed Enhanced Metafile image</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>emz</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.wmz</string>
			<key>UTTypeDescription</key>
			<string>Compressed Windows Metafile image</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>wmz</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>

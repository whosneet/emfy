<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The emfy-mcp helper (GitHub/DMG build only) must read the app's App Group
	     defaults to see whether the user enabled the MCP server; without the group
	     the enable gate reads nil and fails closed. ONLY the application-groups
	     entitlement — no sandbox, no network. Must match the app's group
	     ($(TeamIdentifierPrefix)com.avneetsingh.emfy in Emfy-DMG.entitlements). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)com.avneetsingh.emfy</string>
	</array>
</dict>
</plist>

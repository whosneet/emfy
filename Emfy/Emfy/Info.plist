<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Emfy</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.graphics-design</string>
	<key>LSMultipleInstancesProhibited</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>Product of Arrley, built by Neet Singh in Sydney, Australia.
Copyright © 2026 Arrley Pty Ltd. MIT licensed.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Enhanced Metafile image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<!-- .emf has no system UTI; whichever installed app's imported
			     declaration wins LaunchServices arbitration becomes the file's
			     type, so we claim the known contenders (Microsoft's identifier
			     plus LibreOffice's, which wins when LibreOffice is installed). -->
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.emf</string>
				<string>org.libreoffice.emf-document</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Windows Metafile image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<!-- .wmf has no system UTI either; same arbitration as .emf.
			     LibreOffice exports org.libreoffice.wmf-document, which wins
			     when LibreOffice is installed, so it is claimed too. -->
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.wmf</string>
				<string>org.libreoffice.wmf-document</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Compressed Enhanced Metafile image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<!-- .emz is a gzip-wrapped .emf; no app declares it, so Emfy's
			     imported type resolves it. -->
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.emz</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Compressed Windows Metafile image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<!-- .wmz is a gzip-wrapped .wmf; no app declares it, so Emfy's
			     imported type resolves it. -->
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.wmz</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.emf</string>
			<key>UTTypeDescription</key>
			<string>Enhanced Metafile image</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.image</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>emf</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.wmf</string>
			<key>UTTypeDescription</key>
			<string>Windows Metafile image</string>
			<!-- WMF is directly an image, like EMF → public.image. -->
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.image</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>wmf</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.emz</string>
			<key>UTTypeDescription</key>
			<string>Compressed Enhanced Metafile image</string>
			<!-- .emz is a gzip container that must be inflated before it is an
			     image → public.data, not public.image. -->
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>emz</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.wmz</string>
			<key>UTTypeDescription</key>
			<string>Compressed Windows Metafile image</string>
			<!-- .wmz is a gzip container that must be inflated before it is an
			     image → public.data, not public.image. -->
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>wmz</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
